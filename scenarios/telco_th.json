{
  "name": "telco-th",
  "language": "th",
  "tools": [
    {
      "name": "check_balance",
      "description": "Return the customer's outstanding bill balance and due date for the current billing cycle.",
      "parameters": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Customer identifier (4-digit number), e.g. '2749'."
          }
        },
        "required": ["customer_id"]
      }
    },
    {
      "name": "check_plan",
      "description": "Return the customer's current mobile plan name, monthly fee (THB), and included quota (voice minutes and data GB).",
      "parameters": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Customer identifier (4-digit number), e.g. '2749'."
          }
        },
        "required": ["customer_id"]
      }
    },
    {
      "name": "check_usage",
      "description": "Return the customer's month-to-date usage: voice minutes used and data GB consumed, plus remaining quota.",
      "parameters": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Customer identifier (4-digit number), e.g. '2749'."
          }
        },
        "required": ["customer_id"]
      }
    },
    {
      "name": "open_ticket",
      "description": "Open a support ticket with a short Thai summary and a category. Returns the new ticket id.",
      "parameters": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Customer identifier (4-digit number), e.g. '2749'."
          },
          "category": {
            "type": "string",
            "enum": ["billing", "network", "device", "plan_change", "other"],
            "description": "Issue category."
          },
          "summary_th": {
            "type": "string",
            "description": "One-sentence Thai summary of the issue."
          }
        },
        "required": ["customer_id", "category", "summary_th"]
      }
    }
  ],
